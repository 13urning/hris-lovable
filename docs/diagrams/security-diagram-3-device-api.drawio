    <mxCell id="title" value="FIGURE 3 &#8212; DEVICE ATTENDANCE API FLOW (CLOCK-IN / CLOCK-OUT STATE MACHINE)" style="text;strokeColor=none;fillColor=none;align=center;fontFamily=Montserrat;fontSize=13;fontStyle=1;fontColor=#010101;" vertex="1" parent="1">
      <mxGeometry x="234" y="20" width="700" height="30" as="geometry" />
