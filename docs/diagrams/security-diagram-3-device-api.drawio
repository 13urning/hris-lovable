    </mxCell>
    <mxCell id="device" value="Attendance Device&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;NFC tap / biometric scan / kiosk&lt;br&gt;POST /api/attendance/clock-in&lt;br&gt;X-Device-Key header + employeeCode&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#15A6A1;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="60" y="100" width="230" height="90" as="geometry" />
    </mxCell>
    <mxCell id="g1" value="GATE 1 &#183; Rate limit&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;30 req / 10 s per client IP (sliding window)&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=10;fontStyle=1;fillColor=#036A6B;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="370" y="80" width="220" height="60" as="geometry" />
    </mxCell>
    <mxCell id="g2" value="GATE 2 &#183; Device key&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;SHA-256 + timingSafeEqual, fail-closed&lt;br&gt;channel scope: key:label:channel&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=10;fontStyle=1;fillColor=#036A6B;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="370" y="170" width="220" height="60" as="geometry" />
    </mxCell>
    <mxCell id="g3" value="GATE 3 &#183; Input hardening&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;4 KB cap &#183; JSON only &#183; control chars rejected&lt;br&gt;strict channel slug&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=10;fontStyle=1;fillColor=#036A6B;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="370" y="260" width="220" height="60" as="geometry" />
    </mxCell>
    <mxCell id="g4" value="GATE 4 &#183; Geofence&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;office_networks CIDR check &#183; same rules as web&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=10;fontStyle=1;fillColor=#036A6B;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="370" y="350" width="220" height="60" as="geometry" />
    </mxCell>
    <mxCell id="smZone" value="SERVER-TIME STATE MACHINE (PH TIME, ANTI-TAMPER)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#15A6A1;dashed=1;fontFamily=Montserrat;fontSize=10;fontStyle=1;fontColor=#15A6A1;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="660" y="80" width="450" height="380" as="geometry" />
    </mxCell>
    <mxCell id="st1" value="First tap of day&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#cccccc'&gt;INSERT &#8230; ON CONFLICT DO NOTHING &#8594; clocked in&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=10;fontStyle=1;fillColor=#393939;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="690" y="120" width="180" height="70" as="geometry" />
    </mxCell>
    <mxCell id="st2" value="Tap again too soon&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#cccccc'&gt;dwell &amp;lt; MIN_DWELL_MINUTES &#8594; CLOCKOUT_TOO_SOON (no-op)&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=10;fontStyle=1;fillColor=#393939;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="900" y="120" width="180" height="70" as="geometry" />
    </mxCell>
    <mxCell id="st3" value="Clock-out tap&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#cccccc'&gt;UPDATE &#8230; SET time_out WHERE time_out IS NULL&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=10;fontStyle=1;fillColor=#393939;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="690" y="230" width="180" height="70" as="geometry" />
    </mxCell>
    <mxCell id="st4" value="Any later tap&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#cccccc'&gt;time_out already set &#8594; ALREADY_CLOCKED_OUT (no-op)&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=10;fontStyle=1;fillColor=#393939;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="900" y="230" width="180" height="70" as="geometry" />
    </mxCell>
    <mxCell id="guard" value="WRITE-ONCE GUARD: UNIQUE(employee_id, work_date) + time_out IS NULL &#8212; re-taps and device retries are idempotent, race-safe no-ops; hours_worked / undertime computed atomically in the same UPDATE" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=9;fontStyle=1;fontColor=#036A6B;fillColor=#E0F5F5;align=center;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="690" y="330" width="390" height="70" as="geometry" />
    </mxCell>
