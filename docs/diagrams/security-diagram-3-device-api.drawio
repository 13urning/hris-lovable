      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e7" value="429 / 401 / 403 / 400 &#8212; opaque errors, no stack traces, no UUID/email disclosed" style="endArrow=block;html=1;strokeColor=#8A3A16;dashed=1;fontFamily=Montserrat;fontSize=9;fontColor=#8A3A16;" edge="1" parent="1" source="g2" target="device">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="note" value="KEY CONTROLS: fail-closed device-key auth (missing DEVICE_API_KEYS &#8594; all 401) &#183; constant-time comparison across all keys &#183; per-channel key scoping (403 CHANNEL_NOT_ALLOWED) &#183; server PH time defeats device-clock tampering &#183; responses expose display name only &#183; /api/attendance/verify follows the same gate chain without writing" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=9;fontColor=#393939;fillColor=#F5FAFA;align=left;spacing=10;" vertex="1" parent="1">
