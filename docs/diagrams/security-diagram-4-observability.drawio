    <mxCell id="clIngest" value="Cloud Logging — ingest and parse&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;severity, trace, spanId, labels, httpRequest&lt;br&gt;no agent, no sidecar, no second service&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#036A6B;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="704" y="114" width="306" height="72" as="geometry" />
