    <mxCell id="l1" value="1 · src/server.ts — request context (AsyncLocalStorage)&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;traceId parsed from X-Cloud-Trace-Context, requestId, method, path, APP_ENV&lt;br&gt;one user action becomes one correlated thread in Log Explorer&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#036A6B;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="306" y="114" width="348" height="66" as="geometry" />
    </mxCell>
    <mxCell id="l2" value="2 · auth-middleware.ts — observability wrapper&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;try { await next() } catch { logError(...); throw err } — rethrows unchanged&lt;br&gt;adds serverFn name, dbUserId / firebaseUid, latency, outcome&lt;br&gt;single choke point: 102 authMiddleware + 4 strictAuthMiddleware&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#036A6B;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="306" y="196" width="348" height="80" as="geometry" />
    </mxCell>
    <mxCell id="l3" value="3 · log-redact.ts — ALLOWLIST GATE (RA 10173)&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;emits only: err.name, code (SQLSTATE), constraint, severity, routine, stack&lt;br&gt;hard-drops: detail, hint, where, internalQuery, parameters, request bodies&lt;br&gt;final sweep: email + long digit-run scrub (TIN / SSS / PhilHealth / Pag-IBIG)&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#15A6A1;fontColor=#FFFFFF;" vertex="1" parent="1">
