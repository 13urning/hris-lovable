    <mxCell id="clRouter" value="Log Router — retention and access&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#cccccc'&gt;prod bucket — 90 days, restricted Log View&lt;br&gt;staging _Default — 30 days&lt;br&gt;security-audit view — 400 days (narrow scope)&lt;br&gt;reader: wave-hris-log-readers group (IAM)&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#393939;fontColor=#FFFFFF;" vertex="1" parent="1">
