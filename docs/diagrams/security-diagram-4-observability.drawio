    <mxCell id="clMetrics" value="Log-based metrics&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;server_fn_calls / server_fn_errors, labelled by fn + env&lt;br&gt;enables per-function failure alerting&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#15A6A1;fontColor=#FFFFFF;" vertex="1" parent="1">
      <mxGeometry x="704" y="404" width="306" height="66" as="geometry" />
    </mxCell>

    <mxCell id="alerts" value="Cloud Monitoring alert policies  →  Email + Google Chat webhook (business-hours response)&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;new error signature · any single server function ≥5 errors / 10 min · error ratio &amp;gt;5% / 10 min · Cloud Run 5xx class&lt;br&gt;uptime check on prod / · Cloud SQL CPU &amp;gt;80% and disk &amp;gt;85% · log ingestion &amp;gt;25 GiB per month (cost guard)&lt;br&gt;all policies filtered by APP_ENV so production pages and staging does not&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#036A6B;fontColor=#FFFFFF;" vertex="1" parent="1">
