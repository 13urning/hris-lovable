    </mxCell>
    <mxCell id="clErr" value="Error Reporting&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;groups by signature via the ReportedErrorEvent @type&lt;br&gt;notifies on a NEW error signature&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#15A6A1;fontColor=#FFFFFF;" vertex="1" parent="1">
