    <mxCell id="s2" value="2 &#183; Browser captures GPS&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;Geolocation API &#8212; user permission prompt&lt;br&gt;optional: denial never blocks clock-in&lt;br&gt;specific unavailable reason recorded&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#15A6A1;fontColor=#FFFFFF;" vertex="1" parent="1">
