    <mxCell id="s1" value="1 &#183; Employee signs in&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;Firebase email/password&lt;br&gt;forced password change on first login&lt;br&gt;session: 1h idle / 12h absolute cap&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#15A6A1;fontColor=#FFFFFF;" vertex="1" parent="1">
