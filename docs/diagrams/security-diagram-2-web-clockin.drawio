    <mxCell id="s3" value="3 &#183; clockInDTR server function&lt;br&gt;&lt;font style='font-size:9px;font-weight:400;color:#c8eeee'&gt;verify Firebase ID token (Admin SDK)&lt;br&gt;resolve internal user + roles from DB&lt;br&gt;Zod-validated input&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=none;fontFamily=Montserrat;fontSize=11;fontStyle=1;fillColor=#036A6B;fontColor=#FFFFFF;" vertex="1" parent="1">
